# Copie para .env.local (local) ou cadastre na Vercel (produção).

# GA4. Sem ele, o site não carrega o Analytics nem mostra o aviso de cookies.
NEXT_PUBLIC_GA4_ID=

# Envio dos formulários por e-mail (Resend). Sem as três, o formulário
# oferece o WhatsApp com a mensagem pronta no lugar do envio.
RESEND_API_KEY=
LEAD_EMAIL_PARA=
LEAD_EMAIL_DE="Site MX <site@mxseguros.com.br>"
